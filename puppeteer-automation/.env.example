# ─── CAPTCHA Services ─────────────────────────────────────────────────────────
# API key for 2Captcha (https://2captcha.com)
CAPTCHA_API_KEY=your_2captcha_or_anticaptcha_key_here

# ─── Logging ──────────────────────────────────────────────────────────────────
# Log level: error | warn | info | debug
LOG_LEVEL=info

# ─── Proxy Configuration (optional) ──────────────────────────────────────────
# These can also be set in config.json
# PROXY_HOST=proxy.example.com
# PROXY_PORT=8080
# PROXY_USER=username
# PROXY_PASS=password

# ─── Node.js Settings ─────────────────────────────────────────────────────────
NODE_ENV=production
